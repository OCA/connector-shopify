<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_external_stock_import_form" model="ir.ui.view">
        <field name="name">ith.external.stock.import.form</field>
        <field name="model">ith.external.stock.import</field>
        <field name="arch" type="xml">
            <form string="Import Supplier Stock">
                <group>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="complete_snapshot"/>
                </group>
                <footer>
                    <button name="action_import"
                            string="Import Supplier Stock"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_external_stock_import" model="ir.actions.act_window">
        <field name="name">Import Supplier Stock</field>
        <field name="res_model">ith.external.stock.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_external_stock_import"
              name="Import Supplier Stock"
              parent="stock.menu_stock_root"
              action="action_external_stock_import"
              groups="stock.group_stock_manager"
              sequence="95"/>
</odoo>
