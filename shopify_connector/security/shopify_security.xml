<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="module_category_shopify" model="ir.module.category">
        <field name="name">Shopify</field>
        <field
            name="description"
        >Manage Shopify connector configuration and operations.</field>
        <field name="sequence" eval="35" />
    </record>

    <record id="privilege_shopify" model="res.groups.privilege">
        <field name="name">Shopify Connector</field>
        <field name="description">Shopify connector access level.</field>
        <field name="category_id" ref="shopify_connector.module_category_shopify" />
        <field name="sequence" eval="10" />
    </record>

    <record id="group_shopify_manager" model="res.groups">
        <field name="name">Shopify Manager</field>
        <field name="privilege_id" ref="shopify_connector.privilege_shopify" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        <field
            name="user_ids"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>
</odoo>
